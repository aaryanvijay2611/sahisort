# ─── Demo mode ──────────────────────────────────────────────────────────────
# Set to true to enable the no-login demo path ("Try without signing in").
# When on, server functions accept requests without a Firebase token and act as
# the fixed `demo-user` id, and all data is kept in the local JSON store
# (.data/sahisort_store.json) instead of Firestore. Leave false in production.
VITE_DEMO_MODE=false

# ─── Firebase (client) ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Firebase Admin (server, optional) ──────────────────────────────────────
# Without these the app falls back to the local JSON store.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Gemini (server only) ───────────────────────────────────────────────────
# Optional on Netlify: when unset, requests go through the Netlify AI Gateway.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override; falls back to gemini-3.5-flash-lite.
GEMINI_MODEL=
